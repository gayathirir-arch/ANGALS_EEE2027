public class Solution {
    public static void alphaHill(int n) {
        for(int i = 0; i < n; i++) {


            for(int j = 0; j < n - i - 1; j++) {
                System.out.print("  ");
            }


            for(int j = 0; j <= i; j++) {
                System.out.print((char)('A' + j) + " ");
            }

            // decreasing letters
            for(int j = i - 1; j >= 0; j--) {
                System.out.print((char)('A' + j) + " ");
            }

            System.out.println();
        }
    }
}
